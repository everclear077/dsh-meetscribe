{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/index.ts", "src/host/**/*.ts", "src/shared/**/*.ts", "src/word/**/*.ts", "build.mjs", "scripts/**/*.mjs"]
}
